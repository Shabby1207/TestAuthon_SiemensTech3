{
  "name": "Demo_Project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "postinstall": "serenity-bdd update",
    "build": "rimraf build && npm run format && npm run lint && tsc && npm run cucumber-check",
    "cucumber-check": "cucumber-js features/**/*.s --dry-run --require env/set-environment-variables.ts --require world/custom-world.ts --require step-definitions/**/*.ts --require hooks/**/*.ts  --require-module ts-node/register --format-options \"{\\\"snippetInterface\\\": \\\"async-await\\\"}\" --format summary --format progress --format progress-bar  --publish-quiet",
    "debug": "PWDEBUG=1 DEBUG=pw:api cucumber-js",
    "only": "npm run cucumber -- --tags @only",
    "snippets": "cucumber-js features/**/*.feature --dry-run --format snippets",
    "Smoke": "cucumber-js -f @cucumber/pretty-formatter --tags @Smoke & npx ts-node ./src/CucumberReporter.ts",
    "TC01": "cucumber-js -f @cucumber/pretty-formatter --tags @TC01 & npx ts-node ./src/CucumberReporter.ts",
    "TC02": "cucumber-js -f @cucumber/pretty-formatter --tags @TC02 & npx ts-node ./src/CucumberReporter.ts",
    "test": "cucumber-js &npx ts-node ./src/CucumberReporter.ts",
    "all": "cucumber-js -f @cucumber/pretty-formatter --tags @all & npx ts-node ./src/CucumberReporter.ts",
    "test:parallel": "cucumber-js --parallel=2",
    "Retest": "cucumber-js -f @cucumber/pretty-formatter --tags @Retest & npx ts-node ./src/CucumberReporter.ts",
    "MultiCucumberReporter": " npx ts-node ./src/MultiCucumberReporter.ts",
    "mobile:devices": "node -e \"const { devices } = require('playwright'); console.log(Object.keys(devices).join('\\n'));\"",
    "mobile:TC01": "cucumber-js -f @cucumber/pretty-formatter --tags @TC01 & npx ts-node ./src/CucumberReporter.ts",
    "mobile:TC02": "cucumber-js -f @cucumber/pretty-formatter --tags @TC02 & npx ts-node ./src/CucumberReporter.ts",
    "mobile:TC03": "cucumber-js -f @cucumber/pretty-formatter --tags @TC03 & npx ts-node ./src/CucumberReporter.ts",
    "mobile:TC04": "cucumber-js -f @cucumber/pretty-formatter --tags @TC04 & npx ts-node ./src/CucumberReporter.ts",
    "mobile:Smoke": "cucumber-js -f @cucumber/pretty-formatter --tags @Smoke & npx ts-node ./src/CucumberReporter.ts",
    "mobile:all": "cucumber-js -f @cucumber/pretty-formatter --tags @all & npx ts-node ./src/CucumberReporter.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cucumber/messages": "22.0.0",
    "chai": "^4.3.7",
    "crypto-js": "^4.1.1",
    "cucumber": "6.0.7",
    "dotenv": "^16.0.3",
    "install": "0.13.0",
    "moment": "^2.29.4",
    "node-xml-compare": "^0.1.0",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^3.0.3",
    "playwright": "1.38.1",
    "ts-node": "10.9.1",
    "typescript": "^4.9.4",
    "xml-js": "^1.6.11",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "7.3.2",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@playwright/test": "1.38.1",
    "@types/chai": "^4.3.4",
    "@types/crypto-js": "^4.1.1",
    "@types/cucumber": "^7.0.0",
    "@types/pdf-parse": "^1.1.1",
    "@types/xml2js": "^0.4.11",
    "cucumber-html-reporter": "^5.5.1",
    "multiple-cucumber-html-reporter": "3.9.3"
  }
}
